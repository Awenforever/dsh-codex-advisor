{
  "name": "dsh-codex-advisor",
  "version": "0.7.3",
  "description": "Persistent Codex advisor threads for DeepSeek Harness sessions, with a Codex trail, a sidebar status card, and model/effort provenance.",
  "private": false,
  "type": "module",
  "main": "index.js",
  "author": "Awenforever",
  "license": "MIT",
  "homepage": "https://github.com/Awenforever/dsh-codex-advisor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awenforever/dsh-codex-advisor.git"
  },
  "bugs": {
    "url": "https://github.com/Awenforever/dsh-codex-advisor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "advisor",
    "openai-codex",
    "multi-thread"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
